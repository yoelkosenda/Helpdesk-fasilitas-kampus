PORT=3000
NODE_ENV=development
TZ=Asia/Makassar

# Supabase PostgreSQL (isi dengan connection string dari Supabase Dashboard -> Project Settings -> Database)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
JWT_SECRET="isi-dengan-string-acak-panjang"
SEED_PASSWORD="isi-dengan-password-kuat-untuk-akun-seed"
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=4
WAJIB_FOTO=true

# Supabase Storage (opsional untuk lokal, wajib untuk deployment serverless seperti Vercel)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=laporan-foto

# Penutupan otomatis (BR-14)
AUTO_CLOSE_HARI=3
AUTO_CLOSE_MODE=kalender
AUTO_CLOSE_INTERVAL_MENIT=60
AKTIFKAN_SCHEDULER=true

# Set SEED_PASSWORD in .env before running npm run db:seed or npm run setup.
