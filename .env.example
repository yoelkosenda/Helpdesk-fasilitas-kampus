PORT=3000
NODE_ENV=development
TZ=Asia/Makassar

# SQLite (lokal). Untuk PostgreSQL: ubah provider di prisma/schema.prisma
# lalu isi misalnya: postgresql://user:pass@host:5432/helpdesk
DATABASE_URL="file:./dev.db"
JWT_SECRET="isi-dengan-string-acak-panjang"
SEED_PASSWORD="isi-dengan-password-kuat-untuk-akun-seed"
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
WAJIB_FOTO=true

# Penutupan otomatis (BR-14)
AUTO_CLOSE_HARI=3
AUTO_CLOSE_MODE=kalender
AUTO_CLOSE_INTERVAL_MENIT=60
AKTIFKAN_SCHEDULER=true

# Set SEED_PASSWORD in .env before running npm run db:seed or npm run setup.
